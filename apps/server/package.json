{
  "name": "@lab/server",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "tokenizer:setup": "node scripts/download-tokenizer.mjs",
    "test": "node --import tsx --test tests/budget.test.ts tests/history.test.ts"
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.2.0",
    "express": "^5.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
